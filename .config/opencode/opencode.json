{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "find *": "allow",
      "head *": "allow",
      "grep *": "allow",
      "cat *": "allow",
    }
  },
   "provider": {
    "routerai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RouterAI",
      "options": {
        "baseURL": "https://routerai.ru/api/v1",
        "setCacheKey": true
      },
      "models": {
        "openai/gpt-6.1-sol": {
          "name": "6.1 sol",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "provider": {
              "order": ["openai"],
              "allow_fallbacks": false
             }
          }
        },
        "anthropic/claude-sonnet-5": { "name": "Claude Sonnet 5" },
        "z-ai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "options": {
            "reasoningEffort": "high"
          }
        },
        "openai/gpt-6.1-sol": { "name": "GPT 6.1 Sol" },
      }
    }
  },
  "mcp": {
    "routerai": {
      "type": "remote",
      "url": "https://routerai.ru/api/v1/mcp"
    }
  }
}
