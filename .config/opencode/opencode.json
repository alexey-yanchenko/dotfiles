{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "find *": "allow",
      "head *": "allow",
      "grep *": "allow",
      "cat *": "allow",
    }
  },
   "provider": {
    "routerai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RouterAI",
      "options": {
        "baseURL": "https://routerai.ru/api/v1",
        "setCacheKey": true
      },
      "models": {
        "minimax/minimax-m3": {
          "name": "MiniMax M3",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "provider": {
              "order": ["novita"],
              "allow_fallbacks": false
             }
          }
        },
        "anthropic/claude-sonnet-5": { "name": "Claude Sonnet 5" },
        "z-ai/glm-5.3-flash": { "name": "GLM 5.3 Flash" },
        "openai/gpt-5.6-luna": { "name": "GPT 5.6 Luna" },
      }
    }
  }
}
