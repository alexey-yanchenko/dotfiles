{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "find *": "allow",
      "head *": "allow",
      "grep *": "allow",
      "cat *": "allow",
    }
  },
   "provider": {
    "routerai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RouterAI",
      "options": {
        "baseURL": "https://routerai.ru/api/v1",
        "setCacheKey": true
      },
      "models": {
        "minimax/minimax-m3": {
          "name": "MiniMax M3",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "anthropic/claude-sonnet-4.6": { "name": "Claude Sonnet 4.6" },
        "z-ai/glm-5.2": { "name": "GLM 5.2" },
      }
    }
  }
}
